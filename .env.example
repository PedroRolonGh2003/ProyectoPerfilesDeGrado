PORT=3001
# Para desarrollo local, configura DB_*; para Neon, configura DATABASE_URL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=seguimiento_titulacion
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
# DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/neondb?sslmode=require

SESSION_HOURS=12
REMEMBER_SESSION_DAYS=30
PASSWORD_RESET_MINUTES=20
EMAIL_CONFIRMATION_HOURS=24
APP_BASE_URL=http://127.0.0.1:5173

# Opcional: SMTP para enviar confirmaciones y recuperaciones de contraseña.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
