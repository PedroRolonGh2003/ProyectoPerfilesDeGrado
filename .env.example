PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=seguimiento_titulacion
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
# Para Neon, usa DATABASE_URL en lugar de las variables DB_*.
# DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/seguimiento_titulacion?sslmode=require
SESSION_HOURS=12
REMEMBER_SESSION_DAYS=30
# Costo de bcrypt (se limita entre 10 y 14; 12 es el valor recomendado).
BCRYPT_ROUNDS=12
# Vigencia (10 a 60 minutos) y máximo de solicitudes en 15 minutos.
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_REQUEST_LIMIT=3
# URL pública del frontend que recibirá el enlace de recuperación.
APP_URL=http://localhost:5173
# Opcional: URL HTTPS de un servicio de entrega de correo. Recibe JSON { to, subject, text }.
# EMAIL_DELIVERY_WEBHOOK_URL=
# EMAIL_DELIVERY_WEBHOOK_TOKEN=
