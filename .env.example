PORT=3001
# En entornos administrados, DATABASE_URL tiene prioridad sobre las variables DB_*.
# DATABASE_URL=postgresql://usuario:contrasena@host/seguimiento_titulacion?sslmode=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=seguimiento_titulacion
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
SESSION_HOURS=12
# Ventana de inactividad; se renueva al usar una sesión persistente.
REMEMBER_SESSION_DAYS=90
EMAIL_CONFIRMATION_HOURS=24
PASSWORD_RESET_HOURS=1
# Protege la tarea diaria de recordatorios en Vercel. Usa un valor aleatorio
# de al menos 16 caracteres y configúralo también en las variables del proyecto.
CRON_SECRET=
# URL pública del frontend, usada en el enlace de confirmación. En Vercel puede omitirse.
APP_BASE_URL=http://127.0.0.1:5173
# SMTP es obligatorio para enviar la confirmación de cuentas nuevas.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Web Push (VAPID). Genera una pareja con: npm exec web-push generate-vapid-keys
# Define las tres variables también en Vercel para habilitar los avisos móviles.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte.titulacion@univalle.edu
# Los documentos se guardan en la base de datos configurada por DATABASE_URL.
# No se requiere una carpeta uploads/ persistente en Vercel.

# Mantenimiento opcional: migración de una base local a una base Neon vacía.
# NEON_DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/seguimiento_titulacion?sslmode=require
# PG_DUMP_PATH=pg_dump
# PG_RESTORE_PATH=pg_restore

# QA opcional. API_URL solo cambia el destino de las pruebas PWA.
# API_URL=http://127.0.0.1:3001
# QA_STUDENT_EMAIL=estudiante@est.univalle.edu
# QA_STUDENT_PASSWORD=
