PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=seguimiento_titulacion
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
# Para Neon, usa DATABASE_URL en lugar de las variables DB_*.
# DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/seguimiento_titulacion?sslmode=require
SESSION_HOURS=12
REMEMBER_SESSION_DAYS=30
EMAIL_CONFIRMATION_HOURS=24
PASSWORD_RESET_HOURS=1
# Protege la tarea diaria de recordatorios en Vercel. Usa un valor aleatorio
# de al menos 16 caracteres y configúralo también en las variables del proyecto.
CRON_SECRET=
# URL pública del frontend, usada en el enlace de confirmación. En Vercel puede omitirse.
APP_BASE_URL=http://127.0.0.1:5173
# SMTP es obligatorio para enviar la confirmación de cuentas nuevas.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Web Push (VAPID). Genera una pareja con: npm exec web-push generate-vapid-keys
# Define las tres variables también en Vercel para habilitar los avisos móviles.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte.titulacion@univalle.edu
# Los documentos se guardan en la base de datos configurada por DATABASE_URL.
# No se requiere una carpeta uploads/ persistente en Vercel.
