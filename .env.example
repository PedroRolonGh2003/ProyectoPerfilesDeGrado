PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=seguimiento_titulacion
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
# Para Neon, usa DATABASE_URL en lugar de las variables DB_*.
# DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/seguimiento_titulacion?sslmode=require
SESSION_HOURS=12
REMEMBER_SESSION_DAYS=30
PASSWORD_RESET_MINUTES=20
EMAIL_CONFIRMATION_HOURS=24
APP_BASE_URL=http://127.0.0.1:5173

# SMTP para enviar confirmaciones, recuperación de contraseña y notificaciones.
# Gmail: usa una contraseña de aplicación real del correo remitente.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seguimiento.titulacion@gmail.com
SMTP_PASSWORD=TU_APP_PASSWORD
SMTP_FROM=Seguimiento de Titulación <seguimiento.titulacion@gmail.com>
