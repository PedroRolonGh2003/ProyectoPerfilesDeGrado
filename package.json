{
  "name": "proyecto-perfiles-de-grado",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "qa": "node server/qa.mjs",
    "qa:flow": "node server/qa-fullflow.mjs",
    "qa:tutor": "node server/qa-tutor-flow.mjs",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.1.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
