{
  "framework": "vite",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/review-reminders", "schedule": "0 12 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?route=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
